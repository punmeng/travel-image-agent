# Copy values into your shell or azd environment; Python does not auto-load .env.
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
MAI_IMAGE_ENDPOINT=https://<account>.services.ai.azure.com/mai/v1/images/generations
FOUNDRY_AGENT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/agents/travel-image-agent/endpoint/protocols/invocations?api-version=v1
AZURE_TENANT_ID=<tenant-id>
# Optional hosted user-assigned managed identity.
AZURE_CLIENT_ID=
# Required only for response_format=url. Use an existing PRIVATE container.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=travel-images
IMAGE_URL_TTL_HOURS=24
